{
  "name": "@rustlanges/showcase",
  "private": true,
  "version": "0.0.10",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/src/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/src/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RustLangES/design-system-components",
    "directory": "js/showcase"
  },
  "scripts": {
    "build": "tsc -b ./tsconfig.lib.json && vite build && npm run check:tsc && npm run build:tailwindcss",
    "build:tailwindcss": "pnpm exec @tailwindcss/cli -i src/styles.css -o dist/styles.css --minify",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && pnpm run check:tsc",
    "check:tsc": "tsc --noEmit -p tsconfig.lib.json"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rustlanges/styles": "file:../../styles",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "^8.20.0",
    "dom-expressions": "^0.40.8",
    "eslint": "^10.8.1",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "alien-signals": "^3.2.1",
    "clsx": "^2.1.1"
  }
}
