{
  "name": "@rustlanges/vue",
  "private": false,
  "version": "0.0.10",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./dev": {
      "default": "./lib/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RustLangES/design-system-components",
    "directory": "js/vue"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:showcase-deps && pnpm run check:tsc && vite build && pnpm run build:tailwindcss",
    "build:showcase": "BUILD_SHOWCASE=1 NODE_ENV=development pnpm run build",
    "build:showcase-deps": "cd ../showcase && pnpm run build 2>/dev/null || true",
    "build:tailwindcss": "pnpm exec @tailwindcss/cli -i lib/styles.css -o dist/styles.css --minify",
    "lint": "eslint . --ext ts,vue --report-unused-disable-directives --max-warnings 0 && pnpm run check:tsc",
    "check:tsc": "vue-tsc --build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rustlanges/showcase": "file:../showcase",
    "@rustlanges/styles": "file:../../styles",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "ajv": "^8.20.0",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.10.0",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
